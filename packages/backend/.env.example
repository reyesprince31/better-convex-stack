# Convex Deployment (managed by Convex CLI)
CONVEX_DEPLOYMENT=dev:<your-deployment-name>

# Better Auth Configuration
# BETTER_AUTH_SECRET=<32+ char random string, e.g. generated via `openssl rand -base64 32`>
# SITE_URL=http://localhost:3001

# Resend Email Configuration (Set via Convex Dashboard or `npx convex env set <KEY> <VALUE>`)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=Acme <onboarding@resend.dev>

# Cloudflare R2 Storage (Set via Convex Dashboard or `npx convex env set <KEY> <VALUE>`)
# R2_BUCKET=<your-bucket-name>
# R2_TOKEN=<your-cloudflare-api-token>
# R2_ACCESS_KEY_ID=<your-r2-access-key-id>
# R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

